# PLACEHOLDERS ONLY. Copy into your secure environment or a restricted file OUTSIDE git.
# These names are a setup inventory, not an implemented hosted test command.
TASTEPRINT_STAGING_PROJECT_REF=YOUR_NEW_FREE_STAGING_PROJECT_REF
TASTEPRINT_STAGING_URL=https://YOUR_NEW_FREE_STAGING_PROJECT_REF.supabase.co
TASTEPRINT_STAGING_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_KEY
# Secret: staging server secret key OR legacy staging service_role key.
TASTEPRINT_STAGING_ADMIN_KEY=SET_SECURELY_DO_NOT_COMMIT
# Copy DIRECT or SESSION POOLER parameters from Supabase Connect; never transaction mode.
TASTEPRINT_STAGING_DB_HOST=YOUR_STAGING_DATABASE_OR_SESSION_POOLER_HOST
TASTEPRINT_STAGING_DB_PORT=5432
TASTEPRINT_STAGING_DB_USER=postgres.YOUR_NEW_FREE_STAGING_PROJECT_REF
TASTEPRINT_STAGING_DB_NAME=postgres
TASTEPRINT_STAGING_DB_PASSWORD=SET_SECURELY_DO_NOT_COMMIT
# Use the correct CA chain for the chosen host, or the system trust store where supported.
TASTEPRINT_STAGING_DB_SSLROOTCERT=/absolute/path/to/appropriate-ca.pem
TASTEPRINT_STAGING_APPROVED_COMMIT=f4befb8b441d2c03751369b347b6158d6edb0108
# Never copy ADMIN_KEY or DB_PASSWORD to VITE_* / browser configuration.
