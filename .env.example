# Tasteprint remains functional and demoable without these values.
# When configured, the public Supabase project enables anonymous analytics/profile rows,
# published campaigns, hosted Campaign Workspace drafts, referral aggregates, and optional
# passwordless Passport account sync.
#
# This historical variable name can hold the CURRENT public/publishable Supabase client key.
# Public/publishable keys are browser-safe only when RLS/permissions are correct.
# NEVER put a Supabase secret/service-role key or any other backend master credential in VITE_*.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional preferred public-key alias. All clients share this configuration. Both keys,
# if supplied during migration, must be public. Leave blank until a test backend is approved.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Review-only private Plans UI. Leave off until a specific staging project,
# migration, Auth redirects and synthetic test scope receive founder approval.
VITE_PRIVATE_PLANS_ENABLED=false

# Review-only private connections. New schema is outside PR #24 staging approval.
VITE_PRIVATE_FRIENDS_ENABLED=false

# Review-only shared shortlist. Requires Friends + Plans gates and new approved schema.
VITE_PRIVATE_SHORTLISTS_ENABLED=false

# Build validation rejects unknown VITE_* names, secret/service-role keys, invalid URLs,
# and enabled private features without backend configuration. These values are PUBLIC.

# Review-only private reflection. Requires Plans and an independently approved new schema.
VITE_PRIVATE_REFLECTION_ENABLED=false

# Private in-app updates, requires Plans and Friends; no email/push service.
VITE_PRIVATE_UPDATES_ENABLED=false

# Authenticated contributor/reviewer/publisher workbench, separate from company verification.
VITE_CATALOG_TEAM_ENABLED=false

# Consumer views use only the configured reviewed catalog when enabled, with no private/bundled fallback.
VITE_REVIEWED_CATALOG_ENABLED=false

# Explicit private account copies of interests/saves, with version guards; not automatic sync.
VITE_PRIVATE_PREFERENCES_ENABLED=false

# Shared hard requirements; requires reviewed catalog, private shortlists, Friends and Plans.
# New schema requires separate approval before any hosted activation.
VITE_SHORTLIST_REQUIREMENTS_ENABLED=false
