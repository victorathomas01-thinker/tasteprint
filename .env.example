# Tasteprint remains functional and demoable without these values.
# When configured, the public Supabase project enables anonymous analytics/profile rows,
# published campaigns, hosted Campaign Workspace drafts, referral aggregates, and optional
# passwordless Passport account sync.
#
# This historical variable name can hold the CURRENT public/publishable Supabase client key.
# Public/publishable keys are browser-safe only when RLS/permissions are correct.
# NEVER put a Supabase secret/service-role key or any other backend master credential in VITE_*.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Optional alias recognized by the newer Workspace/campaign code. The older client modules
# still read VITE_SUPABASE_ANON_KEY, so keep the value above configured during migration.
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Review-only private Plans UI. Leave off until a specific staging project,
# migration, Auth redirects and synthetic test scope receive founder approval.
VITE_PRIVATE_PLANS_ENABLED=false

# Review-only private connections. New schema is outside PR #24 staging approval.
VITE_PRIVATE_FRIENDS_ENABLED=false
