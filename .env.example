# Tasteprint remains fully functional without these values.
# When configured, the public Supabase project enables anonymous analytics/profile rows,
# published campaign features, and optional passwordless Passport account sync.
# The anon/publishable key is public by design; never put the service-role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
